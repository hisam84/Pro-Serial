# ── Serial Pro environment variables ─────────────────────────────
# Copy to .env.local for development. Never commit real secrets.

# Neon/PostgreSQL connection string (use the POOLED connection string in
# production — Neon "Pooler" URL — because this app runs on serverless).
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Leave EMPTY to use the built-in local PGlite dev database (file-persisted,
# zero config — intended for development and demos only).
DATABASE_URL=

# Directory for the built-in PGlite dev database (ignored when DATABASE_URL is set).
# Use ":memory:" for an ephemeral database (tests).
PG_LITE_DIR=.pglite-data

# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Set to "true" only in production. Forces Secure cookies.
# (NODE_ENV=production enables this automatically.)
# COOKIE_SECURE=true

# ── First Super Admin (used ONLY by `npm run superadmin`) ────────
# Prefer entering values at the interactive prompt instead of storing
# them in this file.
SUPER_ADMIN_NAME=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
